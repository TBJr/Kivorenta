# --- Kivorenta (copy to .env and fill in; never commit real secrets) ---

# Branding (optional — defaults shown)
APP_NAME=Kivorenta
APP_COMPANY_NAME=TBJr

# Public URLs (must match your deployment)
# Browser: set VITE_APP_URL to the same origin users visit (also used for canonical links).
VITE_APP_URL=http://localhost:5173
VITE_CONTACT_EMAIL=

BETTER_AUTH_URL=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# Generate a new secret for each environment (min 32 characters). Do not reuse SendStack production values.
BETTER_AUTH_SECRET=replace-with-a-long-random-string-at-least-32-chars

# Neon PostgreSQL — use a new database/project for Kivorenta only
DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# Auth transactional email: console (dev) | smtp | disabled
AUTH_EMAIL_DELIVERY=console
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Queue / Redis (simulation only; do not enable live campaign sending)
QUEUE_ENABLED=false
QUEUE_SIMULATION_ONLY=true
REDIS_URL=
QUEUE_NAMESPACE=kivorenta

# Spacemail mailbox (optional until you configure outbound/IMAP testing)
SPACEMAIL_SMTP_HOST=mail.spacemail.com
SPACEMAIL_SMTP_PORT=587
SPACEMAIL_SMTP_SECURE=false
SPACEMAIL_IMAP_HOST=mail.spacemail.com
SPACEMAIL_IMAP_PORT=993
SPACEMAIL_IMAP_SECURE=true
SPACEMAIL_EMAIL=
SPACEMAIL_PASSWORD=
SPACEMAIL_TEST_RECIPIENT=
SPACEMAIL_SENDER_NAME=

# One-time bootstrap (required email; password via prompt or BOOTSTRAP_ADMIN_PASSWORD)
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_NAME=Administrator
# BOOTSTRAP_ADMIN_PASSWORD=

# Destructive DB reset guard
# SENDSTACK_DB_RESET_CONFIRM=yes

# Optional: load a specific env file (also supports legacy SENDSTACK_ENV_FILE)
# APP_ENV_FILE=.env.production
